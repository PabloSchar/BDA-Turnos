<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Nexo Salud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/nexo-salud.css" asp-append-version="true">
</head>
<body>

    <!-- SIDEBAR IZQUIERDO -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-logo"><i class="bi bi-heart-pulse"></i></div>
            <div><b>Nexo Salud</b><small>Gestión clínica</small></div>
        </div>
        <nav class="nav">
            <div class="nav-title">OPERACIÓN</div>
            <a href="#"><i class="bi bi-grid"></i> Resumen</a>
            <a asp-controller="Dashboard" asp-action="Especialidades" class="active">
                <i class="bi bi-calendar3"></i> Agenda médica <span class="badge">12</span>
            </a>
            <a href="#"><i class="bi bi-people"></i> Pacientes</a>
            <a href="#"><i class="bi bi-heart-pulse"></i> Profesionales</a>
            <div class="nav-title">ADMINISTRACIÓN</div>
            <a href="#"><i class="bi bi-building"></i> Sedes</a>
            <a href="#"><i class="bi bi-bar-chart"></i> Reportes</a>
            <a href="#"><i class="bi bi-gear"></i> Configuración</a>
        </nav>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main">
        <!-- TOPBAR -->
        <header class="topbar">
            <div class="sede"><i class="bi bi-hospital"></i> Centro Médico Belgrano <i class="bi bi-chevron-down"></i></div>
            <div class="top-right">
                <div class="user">
                    <span class="avatar">
                        @(User.Identity?.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper() ?? "US")
                    </span>
                    <div>
                        <b>@(User.Identity?.Name ?? "Usuario")</b>
                        <small>Administración</small>
                    </div>
                </div>
                <a asp-controller="ControladoraSesion" asp-action="Salir" title="Cerrar sesión" style="margin-left: 10px;">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </header>

        <!-- RENDERIZADO DE LAS VISTAS -->
        <main class="page">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>